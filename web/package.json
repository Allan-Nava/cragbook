{
  "name": "cragbook-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "cragbook's page: React + TypeScript, built by Vite; the API is the Go backend's.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "vite build && playwright test",
    "build:demo": "vite build --mode demo --base ./ --outDir dist-demo"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.15.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
